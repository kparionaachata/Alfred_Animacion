# Repo minimo para renderizar en la nube: solo scripts de render y los generadores/JSON de la parte 2.
# Todo lo demas se ignora. Los .blend, texturas, mallas, audio y video NO se suben (limite de 100 MB por archivo en GitHub).

/*
!/.gitignore
!/render_nube/
!/chats/
!/README.md
!/generador de animaciones/

/generador de animaciones/*
!/generador de animaciones/alfred/
!/generador de animaciones/jerry/

/generador de animaciones/alfred/*
!/generador de animaciones/alfred/refinar/
/generador de animaciones/alfred/refinar/*
!/generador de animaciones/alfred/refinar/docs/
!/generador de animaciones/alfred/refinar/animaciones_ia/

/generador de animaciones/jerry/*
!/generador de animaciones/jerry/refinar/
/generador de animaciones/jerry/refinar/*
!/generador de animaciones/jerry/refinar/animaciones_ia/

# capitulo 4 (ring, base_ranas_2 / base_ranas_3): solo los scripts, add-ons y datos en texto
!/capitulos/
/capitulos/*
!/capitulos/capitulo_4/
/capitulos/capitulo_4/**/*.*
!/capitulos/capitulo_4/**/
!/capitulos/capitulo_4/**/*.py
!/capitulos/capitulo_4/**/*.json
!/capitulos/capitulo_4/**/*.md
!/capitulos/capitulo_4/**/*.txt

# dentro de lo incluido, solo texto
*.blend
*.blend1
*.png
*.jpg
*.jpeg
*.exr
*.hdr
*.mp4
*.wav
*.mp3
*.fbx
*.obj
*.zip
__pycache__/
*.pyc

# transcripciones de los chats (jsonl comprimido, sin imagenes)
!/chats/*.zip
# Variador musical: versionar la aplicacion, no el motor/modelos ni los audios.
!/musica_variaciones/
/musica_variaciones/*
!/musica_variaciones/estudio_musical.py
!/musica_variaciones/abrir_estudio_musical.py
!/musica_variaciones/test_estudio_musical.py
!/musica_variaciones/Abrir Variador de Musica.cmd
!/musica_variaciones/instalar.ps1
!/musica_variaciones/LEEME.md
# documentos de continuidad entre cuentas
!/refinar/
/refinar/*
!/refinar/docs/
# personaje the Stalker y recorridos: solo estos scripts
!/estructura_lista/
/estructura_lista/*
!/estructura_lista/stalker_aspecto.py
!/recorrido/
/recorrido/*
!/recorrido/blender_path_bloques.py

# La Delgada Linea Roja (proyecto paralelo): solo guias, scripts y los datos CC0 de MPFB
!/capitulos/delgada_linea_roja/
/capitulos/delgada_linea_roja/*
!/capitulos/delgada_linea_roja/CONTINUAR_AQUI.md
!/capitulos/delgada_linea_roja/extractor/
!/capitulos/delgada_linea_roja/extractor/**/*.obj
# guia automatica para Claude
!/CLAUDE.md

# skills del proyecto (las reglas de CLAUDE.md las usan; copiar a ~/.claude/skills/ en la otra cuenta)
!/.claude/
/.claude/*
!/.claude/skills/

# add-ons de Alfred, Jerry, rat_1 y chicken_1 (solo texto), mas la guia y los docs de Jerry
*.bak
!/generador de animaciones/alfred/refinar/alfred_animation_studio/
!/generador de animaciones/jerry/refinar/jerry_animation_studio/
!/generador de animaciones/jerry/refinar/GUIA_ANIMACION_JERRY.md
!/generador de animaciones/jerry/refinar/docs/
!/generador de animaciones/rat_1/
/generador de animaciones/rat_1/*
!/generador de animaciones/rat_1/refinar/
/generador de animaciones/rat_1/refinar/*
!/generador de animaciones/rat_1/refinar/rat_1_animation_studio/
!/generador de animaciones/chicken_1/
/generador de animaciones/chicken_1/*
!/generador de animaciones/chicken_1/refinar/
/generador de animaciones/chicken_1/refinar/*
!/generador de animaciones/chicken_1/refinar/chicken_1_animation_studio/

# 2026-11-07: voces y sonidos procesados del capitulo 4 (archivos pequenos, los usa base_tarde con las ranas_1.blend)
!/capitulos/capitulo_4/voces_alfred/*
!/capitulos/capitulo_4/voces_jerry/*
!/capitulos/capitulo_4/sonidos_pollos_desesperados/*
# render DLSS por comando (solo los .bat/.ps1/.py, no los frames)
!/renderizado/
/renderizado/*
!/renderizado/*.bat
!/renderizado/*.ps1
!/renderizado/*.py
# add-on del cerdo (cerdo_1_animation_studio) y su guia de portado
!/generador de animaciones/cerdo_1/
/generador de animaciones/cerdo_1/*
!/generador de animaciones/cerdo_1/refinar/
/generador de animaciones/cerdo_1/refinar/*
!/generador de animaciones/cerdo_1/refinar/cerdo_1_animation_studio/
!/generador de animaciones/cerdo_1/refinar/PORTADO_CERDO_1.md
